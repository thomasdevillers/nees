# Copy to .env.local. Never commit real values.
ADMIN_PASSWORD=
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only: the secret key (sb_secret_…) or the legacy service_role key.
SUPABASE_SECRET_KEY=
# Cloudflare R2 (client photos & videos) → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
